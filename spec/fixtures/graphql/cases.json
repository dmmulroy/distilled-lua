      { "map": { "q": [{ "item": true }, "name"] } }] } },
  { "id": "linear.issue_create", "sdk": "linear",
    "plan": { "q": [{ "root": "issueCreate", "args": { "input": { "teamId": "T1", "title": "Bug", "labelIds": ["L1", "L2"], "priority": 2, "description": null } } },
      "issue", "identifier"] } },
  { "id": "linear.teams_pages", "sdk": "linear",
    "pages": { "q": [{ "root": "teams", "args": { "first": 2 } }, { "map": { "q": [{ "item": true }, "id"] } }] } },
  { "id": "linear.literal_and_root", "sdk": "linear",
    "plan": { "obj": { "lit": { "lit": 7 }, "of": { "of": "x" }, "viewer": { "q": [{ "root": "viewer" }, "id"] } } } },

  { "id": "railway.project_services", "sdk": "railway",
    "plan": { "obj": {
      "name": { "q": [{ "root": "project", "args": { "id": "p1" } }, "name"] },
      "services": { "q": [{ "root": "project", "args": { "id": "p1" } }, { "f": "services", "args": { "first": 20 } }, { "map": { "q": [{ "item": true }, "name"] } }] } } } },
  { "id": "railway.variables_secret", "sdk": "railway",
    "plan": { "obj": {
      "a": { "q": [{ "root": "variableCollectionUpsert", "args": { "input": { "environmentId": "e1", "projectId": "p1", "variables": { "S3_SECRET": { "$secret": "first-secret" } } } } }] },
      "b": { "q": [{ "root": "variableCollectionUpsert", "args": { "input": { "environmentId": "e1", "projectId": "p1", "variables": { "S3_SECRET": { "$secret": "second-secret" } } } } }] } } } },
  { "id": "railway.token_leaf", "sdk": "railway",
    "plan": { "q": [{ "root": "apiTokenCreate", "args": { "input": { "name": "ci" } } }] } },
  { "id": "railway.bucket_credentials", "sdk": "railway",
