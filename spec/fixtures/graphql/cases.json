  { "id": "railway.projects_pages_after", "sdk": "railway",
    "pages": { "q": [{ "root": "projects", "args": { "first": 2, "after": "c0" } }] } },

  { "id": "expo_eas.app_by_id", "sdk": "expo_eas",
    "plan": { "obj": {
      "name": { "q": [{ "root": "app" }, { "f": "byId", "args": { "appId": "a1" } }, "fullName"] },
      "icon": { "q": [{ "root": "app" }, { "f": "byId", "args": { "appId": "a1" } }, { "f": "profileImageUrl", "args": { "width": "SIZE_64" } }] } } } },
  { "id": "expo_eas.viewer", "sdk": "expo_eas",
    "plan": { "q": [{ "root": "viewer" }, "username"] } },

  { "id": "github.repository", "sdk": "github",
    "plan": { "obj": {
      "pr": { "q": [{ "root": "repository", "args": { "owner": "o", "name": "r" } }, { "f": "pullRequest", "args": { "number": 7 } }, "title"] },
      "issues": { "q": [{ "root": "repository", "args": { "owner": "o", "name": "r" } }, { "f": "issues", "args": { "first": 10, "states": ["OPEN"] } },
        { "map": { "obj": { "n": { "q": [{ "item": true }, "number"] }, "t": { "q": [{ "item": true }, "title"] } } } }] } } } },
  { "id": "github.node_and_draft", "sdk": "github",
    "plan": { "q": [{ "root": "convertPullRequestToDraft", "args": { "input": { "pullRequestId": "PR_1" } } }, "pullRequest", "isDraft"] } },
  { "id": "github.search_union", "sdk": "github",
    "plan": { "q": [{ "root": "search", "args": { "query": "is:open", "type": "ISSUE", "first": 3 } }, { "map": { "q": [{ "item": true }, "__typename"] } }] } },
  { "id": "github.avatar_sizes", "sdk": "github",
    "plan": { "obj": {
      "a": { "q": [{ "root": "viewer" }, { "f": "avatarUrl", "args": { "size": 64 } }] },
      "b": { "q": [{ "root": "viewer" }, "avatarUrl"] },
      "c": { "q": [{ "root": "viewer" }, "login"] } } } },

  { "id": "fly_io.apps_pages", "sdk": "fly_io",
    "pages": { "q": [{ "root": "apps", "args": { "first": 2, "active": true } }, { "map": { "obj": { "name": { "q": [{ "item": true }, "name"] }, "org": { "q": [{ "item": true }, "organization", "slug"] } } } }] } },
  { "id": "fly_io.addon_sensitive", "sdk": "fly_io",
    "plan": { "obj": {
      "env": { "q": [{ "root": "addOn", "args": { "name": "bucket" } }, "environment"] },
