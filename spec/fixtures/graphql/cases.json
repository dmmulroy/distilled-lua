      { "map": { "obj": { "id": { "q": [{ "item": true }, "accessKeyId"] }, "secret": { "q": [{ "item": true }, "secretAccessKey"] } } } }] } },
  { "id": "railway.project_services_pages", "sdk": "railway", "page_path": ["project", "services"],
