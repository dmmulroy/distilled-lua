  { "id": "linear.teams_nested", "sdk": "linear",
    "plan": { "q": [{ "root": "teams", "args": { "first": 5, "includeArchived": false } },
      { "map": { "obj": { "id": { "q": [{ "item": true }, "id"] }, "key": { "q": [{ "item": true }, "key"] },
        "members": { "q": [{ "item": true }, { "f": "members", "args": { "first": 3 } }, { "map": { "q": [{ "item": true }, "name"] } }] } } } }] } },
  { "id": "linear.issue_aliases", "sdk": "linear",
    "plan": { "obj": {
      "a": { "q": [{ "root": "issue", "args": { "id": "ISS-1" } }, "title"] },
      "b": { "q": [{ "root": "issue", "args": { "id": "ISS-2" } }, "title"] },
      "c": { "q": [{ "root": "issue", "args": { "id": "ISS-1" } }, "assignee", "email"] } } } },
  { "id": "linear.scalar_args", "sdk": "linear",
    "plan": { "obj": {
      "all": { "q": [{ "root": "team", "args": { "id": "T1" } }, { "f": "issueCount", "args": { "includeArchived": true } }] },
      "plain": { "q": [{ "root": "team", "args": { "id": "T1" } }, "issueCount"] } } } },
  { "id": "linear.filter", "sdk": "linear",
    "plan": { "q": [{ "root": "teams", "args": { "first": 10 } },
