#!/bin/sh
# verify/dl: the distilled-lua verification driver. `verify/dl help` lists commands.
#
# POSIX sh on purpose: it must work before any Lua code does (doctor, manifest), it only
# glues together interpreters and files, and every machine that runs it has /bin/sh.
# Heavier logic lives in Lua under verify/lib/ and runs under the runtime being tested.
set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
LIB="$ROOT/verify/lib"
TMP="$ROOT/verify/tmp"
RUNTIMES="lua luajit rex"

say() { printf '%s\n' "$*"; }
die() { printf 'dl: %s\n' "$*" >&2; exit 2; }

# stub NAME WHERE: WHERE is a task number when known, otherwise the plan's build step
stub() {
  say "dl $1: not implemented, see $2"
  exit 2
}

# ----------------------------------------------------------------------------------
# manifest: spec/manifest.lua lists every spec/*_spec.lua (Rex cannot list a directory)
# ----------------------------------------------------------------------------------

manifest_text() {
  say "-- Generated by verify/dl manifest from spec/*_spec.lua. Do not edit."
  say "-- Rex (gopher-lua) has no io.popen, so spec/run.lua reads this list instead."
  say "return {"
  (cd "$ROOT/spec" && ls -1 | LC_ALL=C grep '_spec\.lua$' | LC_ALL=C sort) | while IFS= read -r f; do
    say "  \"$f\","
  done
  say "}"
}

cmd_manifest() {
  manifest_text > "$ROOT/spec/manifest.lua.tmp" && mv "$ROOT/spec/manifest.lua.tmp" "$ROOT/spec/manifest.lua"
  say "wrote spec/manifest.lua ($(grep -c '_spec.lua' "$ROOT/spec/manifest.lua") specs)"
}

manifest_fresh() {
  [ -f "$ROOT/spec/manifest.lua" ] || return 1
  manifest_text | cmp -s - "$ROOT/spec/manifest.lua"
}

# ----------------------------------------------------------------------------------
# doctor
# ----------------------------------------------------------------------------------

cmd_doctor() {
  bad=0
  check() { # name, command...
    name=$1
    shift
    if out=$("$@" 2>&1); then
      say "ok   $name: $(printf '%s' "$out" | head -n 1)"
    else
      say "FAIL $name: $(printf '%s' "$out" | head -n 1)"
      bad=1
    fi
  }
  check lua sh -c 'lua -v'
  check luajit sh -c 'luajit -v'
  check rex sh -c 'rex whoami >/dev/null && rex do -e "return _VERSION"'
  check curl sh -c 'curl --version'
  check stylua sh -c 'stylua --version'
  check node sh -c 'node --version'
  if manifest_fresh; then
    say "ok   manifest: spec/manifest.lua lists every spec"
  else
    say "FAIL manifest: spec/manifest.lua is stale; run verify/dl manifest"
    bad=1
  fi
  if [ "$bad" -ne 0 ]; then
    say "doctor: FAIL"
    exit 1
  fi
  say "doctor: ok"
}

# ----------------------------------------------------------------------------------
# test
# ----------------------------------------------------------------------------------

# run_specs RUNTIME [FILTER]: prints the runner's output, returns its status
run_specs() {
  rt=$1
  filter=${2:-}
  case $rt in
    lua | luajit)
      if [ -n "$filter" ]; then "$rt" "$ROOT/spec/run.lua" "$filter"; else "$rt" "$ROOT/spec/run.lua"; fi
      ;;
    rex)
      if [ -n "$filter" ]; then rex do "$ROOT/spec/run.lua" "filter=$filter"; else rex do "$ROOT/spec/run.lua"; fi
      ;;
    *) die "unknown runtime $rt (lua, luajit or rex)" ;;
  esac
}

cmd_test() {
  runtimes=$RUNTIMES
  filter=""
  fuzz=0
  # --http (task 05): run everything under a private `dl serve`, so the HTTP specs (gated
  # on DL_SERVE_URL) run too; plain `dl test` clears DL_SERVE_URL so they report skipped
  for a in "$@"; do
    if [ "$a" = "--http" ]; then
      if [ -z "${DL_TEST_HTTP:-}" ]; then
        DL_TEST_HTTP=1
        export DL_TEST_HTTP
        serve_with "$0" test "$@"
        exit $?
      fi
    fi
  done
  [ -n "${DL_TEST_HTTP:-}" ] || unset DL_SERVE_URL DL_SERVE_PORT
  while [ $# -gt 0 ]; do
    case $1 in
      --http)
        shift
        ;;
      --runtime)
        [ $# -ge 2 ] || die "--runtime needs lua, luajit or rex"
        runtimes=$2
        shift 2
        ;;
      --runtime=*)
        runtimes=${1#--runtime=}
        shift
        ;;
      --json-fuzz)
        fuzz=1
        shift
        ;;
      --xml-fuzz)
        fuzz=2
        shift
        ;;
      -*) die "unknown option $1" ;;
      *)
        filter=$1
        shift
        ;;
    esac
  done
  if [ "$fuzz" -eq 1 ]; then
    json_fuzz "$runtimes"
    return
  fi
  if [ "$fuzz" -eq 2 ]; then
    xml_fuzz "$runtimes"
    return
  fi
  manifest_fresh || cmd_manifest
  status=0
  summary=""
  for rt in $runtimes; do
    say "== $rt"
    out=$(run_specs "$rt" "$filter" 2>&1)
    code=$?
    say "$out"
    last=$(printf '%s\n' "$out" | grep -E '(^|Error: )(ok|FAIL) ' | tail -n 1)
    [ -n "$last" ] || last="FAIL no summary line (exit $code)"
    if [ "$code" -ne 0 ]; then
      status=1
      summary="$summary
  $rt: FAIL (exit $code) $last"
    else
      summary="$summary
  $rt: $last"
    fi
  done
  say "== summary$summary"
  exit $status
}

# json_fuzz "RUNTIMES": seeded random documents from Node, round-tripped by our codec
json_fuzz() {
  mkdir -p "$TMP"
  seed=${DL_FUZZ_SEED:-20261116}
  count=${DL_FUZZ_COUNT:-400}
  node "$LIB/json_gen.mjs" "$seed" "$count" "$TMP/fuzz_in.bin" "$TMP/fuzz_expected.txt" || die "node generator failed"
  status=0
  for rt in $1; do
    rm -f "$TMP/fuzz_$rt.txt"
    case $rt in
      lua | luajit) "$rt" "$LIB/json_diff.lua" "$TMP/fuzz_in.bin" "$TMP/fuzz_$rt.txt" ;;
      rex) rex do "$LIB/json_diff.lua" "in=$TMP/fuzz_in.bin" "out=$TMP/fuzz_$rt.txt" >/dev/null ;;
      *) die "unknown runtime $rt" ;;
    esac
    if cmp -s "$TMP/fuzz_expected.txt" "$TMP/fuzz_$rt.txt"; then
      say "ok   json-fuzz $rt: $count documents (seed $seed) match JSON.parse/JSON.stringify"
    else
      status=1
      say "FAIL json-fuzz $rt: output differs from Node (seed $seed); first differences:"
      diff "$TMP/fuzz_expected.txt" "$TMP/fuzz_$rt.txt" | head -n 8 | cut -c 1-300
    fi
  done
  exit $status
}

# xml_fuzz "RUNTIMES" (task 15): documents and Distilled's outcomes from Node (xml.ts, with
# its ASCII-name bug patched, checked against its reference parser), parsed by
# distilled.xml under each runtime and compared line for line (tree or error message)
DISTILLED_XML_TS="$ROOT/../distilled/packages/core/src/xml.ts"
xml_fuzz() {
  mkdir -p "$TMP"
  seed=${DL_FUZZ_SEED:-20261116}
  count=${DL_FUZZ_COUNT:-3000}
  [ -f "$DISTILLED_XML_TS" ] || die "xml-fuzz: no $DISTILLED_XML_TS"
  $NODE_TS "$LIB/xml_gen.mjs" "$seed" "$count" "$TMP/xml_in.bin" "$TMP/xml_expected.txt" \
    "$DISTILLED_XML_TS" "$ROOT/spec/fixtures/xml" || die "node generator failed"
  status=0
  for rt in $1; do
    rm -f "$TMP/xml_$rt.txt"
    case $rt in
      lua | luajit) res=$("$rt" "$LIB/xml_diff.lua" "$TMP/xml_in.bin" "$TMP/xml_$rt.txt") ;;
      rex) res=$(rex do "$LIB/xml_diff.lua" "in=$TMP/xml_in.bin" "out=$TMP/xml_$rt.txt" | grep -v '^"') ;;
      *) die "unknown runtime $rt" ;;
    esac
    if cmp -s "$TMP/xml_expected.txt" "$TMP/xml_$rt.txt"; then
      say "ok   xml-fuzz $rt: $res (seed $seed), all match Distilled's xml.ts"
    else
      status=1
      say "FAIL xml-fuzz $rt: output differs from Node (seed $seed); first differences:"
      diff "$TMP/xml_expected.txt" "$TMP/xml_$rt.txt" | head -n 8 | cut -c 1-300
    fi
  done
  exit $status
}

# xml-bench [file] (task 15): parse throughput of distilled.xml per runtime, and of
# Distilled's xml.ts in Node on the same bytes
cmd_xml_bench() {
  mkdir -p "$TMP"
  file=${1:-}
  if [ -z "$file" ]; then
    file="$TMP/xml_bench.xml"
    lua "$LIB/xml_bench.lua" "write=$file" >/dev/null || die "xml-bench: could not build the document"
  fi
  status=0
  for rt in $RUNTIMES; do
    case $rt in
      lua | luajit) "$rt" "$LIB/xml_bench.lua" "$file" || status=1 ;;
      rex) rex do "$LIB/xml_bench.lua" "file=$file" | grep -v '^"' || status=1 ;;
    esac
  done
  if [ -f "$DISTILLED_XML_TS" ]; then
    $NODE_TS --input-type=module -e "
      import { readFileSync } from 'node:fs';
      const { parseXmlSync } = await import(process.argv[1]);
      const text = readFileSync(process.argv[2], 'utf8');
      let best = Infinity;
      for (let i = 0; i < 5; i++) { const t0 = performance.now(); parseXmlSync(text); best = Math.min(best, performance.now() - t0); }
      const mb = Buffer.byteLength(text) / 1048576;
      console.log('node ' + process.version + ' xml.ts: ' + mb.toFixed(2) + ' MB in ' + (best / 1000).toFixed(3) + ' s (' + (mb / best * 1000).toFixed(1) + ' MB/s)');
    " "$DISTILLED_XML_TS" "$file" || status=1
  fi
  exit $status
}

cmd_json_bench() {
  file=${1:-$ROOT/models/neon/neon.json}
  for rt in $RUNTIMES; do
    case $rt in
      lua | luajit) "$rt" "$LIB/json_bench.lua" "$file" ;;
      rex) rex do "$LIB/json_bench.lua" "file=$file" ;;
    esac
  done
}

# crypto-bench / crypto-vectors (task 14): distilled.crypto throughput and Node vectors
cmd_crypto_bench() {
  status=0
  for rt in $RUNTIMES; do
    case $rt in
      lua | luajit) "$rt" "$LIB/crypto_bench.lua" || status=1 ;;
      rex) rex do "$LIB/crypto_bench.lua" || status=1 ;;
    esac
  done
  exit $status
}

cmd_crypto_vectors() {
  node "$LIB/crypto_vectors.mjs" "$ROOT/spec/golden/crypto/vectors.lua" || die "node failed"
  node --conditions=bun --experimental-transform-types --no-warnings "$LIB/sigv4_vectors.mjs" "$ROOT/spec/golden/sigv4/vectors.lua" || die "node failed"
  stylua "$ROOT/spec/golden/crypto/vectors.lua" "$ROOT/spec/golden/sigv4/vectors.lua"
}

# ----------------------------------------------------------------------------------
# fmt
# ----------------------------------------------------------------------------------

cmd_fmt() {
  cd "$ROOT" || exit 2
  dirs=""
  for d in lua spec verify/lib bin providers; do
    [ -d "$d" ] && dirs="$dirs $d"
  done
  if [ "${1:-}" = "--check" ]; then
    # shellcheck disable=SC2086
    stylua --check $dirs
  else
    # shellcheck disable=SC2086
    stylua $dirs
  fi
}

# ----------------------------------------------------------------------------------
# trace / expect (task 02): verify/lib/trace_run.lua does the work in the chosen runtime
# ----------------------------------------------------------------------------------

abs_path() { # abs_path PATH: absolute path of an existing file
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd)" "$(basename "$1")" ;;
  esac
}

# trace_run RUNTIME MODE PATH LEVEL OUT
trace_run() {
  case $1 in
    lua | luajit) "$1" "$LIB/trace_run.lua" "$2" "$3" "$4" "$5" ;;
    rex) rex do "$LIB/trace_run.lua" "mode=$2" "path=$3" "level=$4" "out=$5" ;;
    *) die "unknown runtime $1 (lua, luajit or rex)" ;;
  esac
}

# cmd_trace_or_expect MODE ARGS...
cmd_trace_or_expect() {
  mode=$1
  shift
  rt=lua
  level=debug
  file=""
  script=""
  while [ $# -gt 0 ]; do
    case $1 in
      --runtime)
        [ $# -ge 2 ] || die "--runtime needs lua, luajit or rex"
        rt=$2
        shift 2
        ;;
      --runtime=*)
        rt=${1#--runtime=}
        shift
        ;;
      --level)
        [ $# -ge 2 ] || die "--level needs debug or operation"
        level=$2
        shift 2
        ;;
      --level=*)
        level=${1#--level=}
        shift
        ;;
      --file)
        [ "$mode" = trace ] || die "--file is for dl trace"
        [ $# -ge 2 ] || die "--file needs a path"
        file=$2
        shift 2
        ;;
      -*) die "unknown option $1" ;;
      *)
        [ -z "$script" ] || die "one script at a time"
        script=$1
        shift
        ;;
    esac
  done
  case $level in debug | operation) ;; *) die "--level must be debug or operation" ;; esac
  case $rt in lua | luajit | rex) ;; *) die "unknown runtime $rt (lua, luajit or rex)" ;; esac
  if [ -n "$file" ]; then
    [ -f "$file" ] || die "no such file: $file"
    trace_run "$rt" file "$(abs_path "$file")" "" ""
    exit $?
  fi
  [ -n "$script" ] || die "usage: dl $mode <script.lua> [--level debug|operation] [--runtime lua|luajit|rex]"
  [ -f "$script" ] || die "no such script: $script"
  mkdir -p "$TMP/trace"
  out="$TMP/trace/$(basename "$script" .lua)-$rt.jsonl"
  trace_run "$rt" "$mode" "$(abs_path "$script")" "$level" "$out"
  exit $?
}

# ----------------------------------------------------------------------------------
# serve (task 05): verify/lib/serve.py, a scriptable fixture HTTP server on 127.0.0.1
# ----------------------------------------------------------------------------------

# serve_start DIR: starts serve.py with its pid and port files in DIR; prints the port
serve_start() {
  dir=$1
  mkdir -p "$dir"
  if [ -f "$dir/pid" ] && kill -0 "$(cat "$dir/pid")" 2>/dev/null && [ -f "$dir/port" ]; then
    cat "$dir/port"
    return 0
  fi
  rm -f "$dir/port" "$dir/pid"
  command -v python3 >/dev/null 2>&1 || die "serve: python3 not found"
  nohup python3 "$LIB/serve.py" --port-file "$dir/port" >"$dir/log" 2>&1 </dev/null &
  printf '%s\n' "$!" >"$dir/pid"
  i=0
  while [ ! -s "$dir/port" ]; do
    i=$((i + 1))
    if [ "$i" -gt 100 ] || ! kill -0 "$(cat "$dir/pid")" 2>/dev/null; then
      say "dl serve: server did not start; log:" >&2
      cat "$dir/log" >&2
      return 1
    fi
    sleep 0.05
  done
  cat "$dir/port"
}

# serve_stop DIR: stops the server whose pid file is in DIR (quietly when none runs)
serve_stop() {
  dir=$1
  if [ -f "$dir/pid" ]; then
    pid=$(cat "$dir/pid")
    if kill "$pid" 2>/dev/null; then
      i=0
      while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
        i=$((i + 1))
        sleep 0.05
      done
      kill -9 "$pid" 2>/dev/null
    fi
  fi
  rm -f "$dir/pid" "$dir/port"
}

# serve_with CMD...: starts a private server, runs CMD with DL_SERVE_PORT and DL_SERVE_URL
# set, stops the server on every exit path, returns CMD's status
serve_with() {
  sdir=$(mktemp -d "${TMPDIR:-/tmp}/dl-serve.XXXXXX") || die "serve: mktemp failed"
  trap 'serve_stop "$sdir"; rm -rf "$sdir"' EXIT
  trap 'exit 130' INT TERM
  port=$(serve_start "$sdir") || exit 1
  DL_SERVE_PORT=$port
  DL_SERVE_URL="http://127.0.0.1:$port"
  export DL_SERVE_PORT DL_SERVE_URL
  "$@"
  code=$?
  serve_stop "$sdir"
  rm -rf "$sdir"
  trap - EXIT
  return $code
}

cmd_serve() {
  sub=${1:-help}
  [ $# -gt 0 ] && shift
  case $sub in
    start) serve_start "$TMP/serve" ;;
    stop) serve_stop "$TMP/serve" && say "dl serve: stopped" ;;
    port | url)
      [ -s "$TMP/serve/port" ] || die "serve: not running (dl serve start)"
      if [ "$sub" = url ]; then say "http://127.0.0.1:$(cat "$TMP/serve/port")"; else cat "$TMP/serve/port"; fi
      ;;
    run)
      [ $# -gt 0 ] || die "usage: dl serve run <command> [args...]"
      serve_with "$@"
      exit $?
      ;;
    *) die "usage: dl serve start | stop | port | url | run <command> [args...]" ;;
  esac
}

# ----------------------------------------------------------------------------------
# rex (task 05): run a script or an action through `rex do` with this repo on the path
# ----------------------------------------------------------------------------------

# lua_path: package.path for this repo, through LUA_PATH (lua, luajit and gopher-lua read
# it; ";;" keeps the default path), so nothing under ~/.config/rex is touched
lua_path() {
  printf '%s' "$ROOT/lua/?.lua;$ROOT/lua/?/init.lua;$ROOT/?.lua;;"
}

cmd_rex() {
  serve=0
  if [ "${1:-}" = "--serve" ]; then
    serve=1
    shift
  fi
  [ $# -gt 0 ] || die "usage: dl rex [--serve] <script.lua> [--action NAME] [key=value ...]"
  script=$1
  shift
  [ -f "$script" ] || die "no such script: $script"
  LUA_PATH=$(lua_path)
  export LUA_PATH
  if [ "$serve" -eq 1 ]; then
    serve_with rex do "$(abs_path "$script")" "$@"
  else
    rex do "$(abs_path "$script")" "$@"
  fi
  exit $?
}

# ----------------------------------------------------------------------------------
# canary (task 05): run a script with a fake key and look for the key everywhere
# ----------------------------------------------------------------------------------

# canary_inner RUNTIME SCRIPT WORK: runs under serve_with (DL_SERVE_URL is set)
canary_inner() {
  rt=$1
  script=$2
  work=$3
  (
    while :; do
      ps -axww -o pid=,command= >>"$work/ps.txt" 2>/dev/null
      sleep 0.05
    done
  ) &
  sampler=$!
  case $rt in
    lua | luajit) (cd "$ROOT" && "$rt" "$script") >"$work/stdout.txt" 2>"$work/stderr.txt" ;;
    rex) (cd "$ROOT" && rex do "$script") >"$work/stdout.txt" 2>"$work/stderr.txt" ;;
  esac
  code=$?
  kill "$sampler" 2>/dev/null
  wait "$sampler" 2>/dev/null
  curl -q -s "$DL_SERVE_URL/_dl/requests" >"$work/server.json"
  return $code
}

# canary_check RUNTIME WORK SCRIPT_EXIT: prints findings, returns 1 when anything is wrong
canary_check() {
  rt=$1
  work=$2
  script_code=$3
  bad=0
  for f in stdout.txt stderr.txt trace.jsonl ps.txt; do
    [ -f "$work/$f" ] || continue
    if lines=$(grep -n -F -- "$DL_CANARY_KEY" "$work/$f" | cut -d: -f1 | head -n 5 | tr '\n' ' ') && [ -n "$lines" ]; then
      case $f in
        ps.txt) say "FAIL canary $rt: key in a process command line (ps sample lines $lines)" ;;
        trace.jsonl) say "FAIL canary $rt: key in the trace file (lines $lines)" ;;
        *) say "FAIL canary $rt: key in $f (lines $lines)" ;;
      esac
      bad=1
    fi
  done
  left=$(ls -A "$work/tmp")
  if [ -n "$left" ]; then
    say "FAIL canary $rt: temp files left behind: $(printf '%s' "$left" | tr '\n' ' ')"
    if grep -r -l -F -- "$DL_CANARY_KEY" "$work/tmp" >/dev/null 2>&1; then
      say "FAIL canary $rt: key in a leftover temp file"
    fi
    bad=1
  fi
  if [ "$script_code" -ne 0 ]; then
    say "FAIL canary $rt: the script exited $script_code; stderr:"
    sed -n '1,10p' "$work/stderr.txt" | sed "s/$DL_CANARY_KEY/<CANARY>/g"
    bad=1
  fi
  if [ ! -s "$work/trace.jsonl" ]; then
    say "FAIL canary $rt: no trace was written to DL_CANARY_TRACE (the check needs debug tracing on)"
    bad=1
  fi
  if ! grep -q -E 'curl -q --config|dd bs=1 count=' "$work/ps.txt" 2>/dev/null; then
    say "FAIL canary $rt: no curl process in the ps samples; the script needs a slow request (canary.SLOW_PATH)"
    bad=1
  fi
  # the positive control: the key reached the server, in an authorization header
  if ! python3 - "$work/server.json" <<'PY'; then
import json, os, sys
key = os.environ["DL_CANARY_KEY"]
reqs = json.load(open(sys.argv[1]))
sys.exit(0 if any(key in (r["headers"].get("authorization") or "") for r in reqs) else 1)
PY
    say "FAIL canary $rt: the key never reached dl serve in an authorization header (the run proves nothing)"
    bad=1
  fi
  if [ "$bad" -eq 0 ]; then
    say "ok   canary $rt: key absent from stdout, stderr, trace ($(wc -l <"$work/trace.jsonl" | tr -d ' ') lines), $(grep -c -E 'curl -q --config|dd bs=1 count=' "$work/ps.txt") curl ps entries; reached the server"
  fi
  return $bad
}

cmd_canary() {
  runtimes=$RUNTIMES
  script=""
  keep=0
  while [ $# -gt 0 ]; do
    case $1 in
      --runtime)
        [ $# -ge 2 ] || die "--runtime needs lua, luajit or rex"
        runtimes=$2
        shift 2
        ;;
      --runtime=*)
        runtimes=${1#--runtime=}
        shift
        ;;
      --keep)
        keep=1
        shift
        ;;
      -*) die "unknown option $1" ;;
      *)
        script=$1
        shift
        ;;
    esac
  done
  [ -n "$script" ] || die "usage: dl canary <script.lua> [--runtime R] [--keep]"
  [ -f "$script" ] || die "no such script: $script"
  script=$(abs_path "$script")
  DL_CANARY_KEY="sk-CANARY-$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')"
  LUA_PATH=$(lua_path)
  export DL_CANARY_KEY LUA_PATH
  status=0
  for rt in $runtimes; do
    case $rt in lua | luajit | rex) ;; *) die "unknown runtime $rt" ;; esac
    work=$(mktemp -d "${TMPDIR:-/tmp}/dl-canary.XXXXXX") || die "canary: mktemp failed"
    mkdir "$work/tmp"
    DL_CANARY_TRACE="$work/trace.jsonl"
    export DL_CANARY_TRACE
    # temp files the run creates land here, so leftovers can be found
    (
      TMPDIR="$work/tmp/"
      export TMPDIR
      serve_with canary_inner "$rt" "$script" "$work"
    )
    code=$?
    canary_check "$rt" "$work" "$code" || status=1
    if [ "$keep" -eq 1 ]; then say "     kept $work"; else rm -rf "$work"; fi
  done
  exit $status
}

# ----------------------------------------------------------------------------------
# jaeger (task 05): Jaeger all-in-one in Docker, OTLP HTTP on 4318, UI/API on 16686
# ----------------------------------------------------------------------------------

JAEGER_NAME=dl-jaeger
JAEGER_IMAGE=${DL_JAEGER_IMAGE:-jaegertracing/all-in-one:latest}

jaeger_docker_ok() {
  if ! command -v docker >/dev/null 2>&1; then
    say "dl jaeger: skipped: docker is not installed"
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    say "dl jaeger: skipped: the Docker daemon is not running (dl does not start it)"
    return 1
  fi
}

cmd_jaeger() {
  sub=${1:-help}
  [ $# -gt 0 ] && shift
  case $sub in
    url)
      say "otlp http://127.0.0.1:4318   ui/api http://127.0.0.1:16686"
      ;;
    start)
      jaeger_docker_ok || exit 3
      if [ -n "$(docker ps -q -f "name=^$JAEGER_NAME\$")" ]; then
        say "dl jaeger: already running"
      else
        docker rm -f "$JAEGER_NAME" >/dev/null 2>&1
        docker run -d --name "$JAEGER_NAME" -e COLLECTOR_OTLP_ENABLED=true \
          -p 127.0.0.1:4318:4318 -p 127.0.0.1:16686:16686 "$JAEGER_IMAGE" >/dev/null || die "jaeger: docker run failed"
      fi
      i=0
      until curl -q -s -o /dev/null "http://127.0.0.1:16686/api/services"; do
        i=$((i + 1))
        [ "$i" -lt 100 ] || die "jaeger: the query API did not come up"
        sleep 0.2
      done
      cmd_jaeger url
      ;;
    stop)
      jaeger_docker_ok || exit 3
      docker rm -f "$JAEGER_NAME" >/dev/null 2>&1
      say "dl jaeger: stopped"
      ;;
    check)
      # export one trace through otlp_http + popen_curl, then find it in Jaeger's query API
      jaeger_docker_ok || exit 3
      LUA_PATH=$(lua_path)
      export LUA_PATH
      lua "$LIB/jaeger_check.lua"
      exit $?
      ;;
    *) die "usage: dl jaeger start | stop | url | check" ;;
  esac
}

# ----------------------------------------------------------------------------------
# models (task 10): copy Distilled's patched models into models/<pkg>/<model>.json
# ----------------------------------------------------------------------------------

# Distilled's checkout: a sibling of this repository (DL_DISTILLED overrides it). For a
# worktree (../distilled-lua-NN) it is the same sibling.
DISTILLED=${DL_DISTILLED:-$(cd "$ROOT/.." && pwd)/distilled}
PACKAGES="$DISTILLED/packages"

# lua_name PKG: the Lua module name of a package (fly-io -> fly_io)
lua_name() { printf '%s' "$1" | tr '-' '_'; }

# pkg_of NAME: the package name for a package or Lua name, looked up in models/ and then in
# Distilled's packages (fly_io -> fly-io); prints NAME itself when neither knows it
pkg_of() {
  if [ -d "$ROOT/models/$1" ] || [ -d "$PACKAGES/$1" ]; then
    printf '%s' "$1"
    return
  fi
  dashed=$(printf '%s' "$1" | tr '_' '-')
  if [ -d "$ROOT/models/$dashed" ] || [ -d "$PACKAGES/$dashed" ]; then
    printf '%s' "$dashed"
    return
  fi
  printf '%s' "$1"
}

# spec_packages: every Distilled package with a .generated-specs/*.json model
spec_packages() {
  for d in "$PACKAGES"/*/.generated-specs; do
    [ -d "$d" ] || continue
    ls "$d" | grep -q '\.json$' || continue
    basename "$(dirname "$d")"
  done
}

NODE_CONVERT="node --conditions=bun --experimental-transform-types --no-warnings"

cmd_models() {
  sub=${1:-help}
  [ $# -gt 0 ] && shift
  case $sub in
    sync) ;;
    *) die "usage: dl models sync [--convert] [pkg ...]" ;;
  esac
  convert=0
  pkgs=""
  for a in "$@"; do
    case $a in
      --convert) convert=1 ;;
      -*) die "models sync: unknown flag $a" ;;
      *) pkgs="$pkgs $(pkg_of "$a")" ;;
    esac
  done
  mkdir -p "$TMP"
  [ -d "$PACKAGES" ] || die "models sync: no Distilled checkout at $DISTILLED (set DL_DISTILLED)"
  [ -n "$pkgs" ] || pkgs=$(spec_packages)
  status=0
  total=0
  for pkg in $pkgs; do
    src="$PACKAGES/$pkg/.generated-specs"
    if [ "$convert" -eq 1 ]; then
      if [ ! -f "$PACKAGES/$pkg/scripts/convert.ts" ]; then
        say "FAIL $pkg: no scripts/convert.ts"
        status=1
        continue
      fi
      if ! (cd "$PACKAGES/$pkg" && $NODE_CONVERT scripts/convert.ts) >"$TMP/convert-$pkg.log" 2>&1; then
        say "FAIL $pkg: convert failed ($TMP/convert-$pkg.log): $(tail -n 1 "$TMP/convert-$pkg.log")"
        status=1
        continue
      fi
    fi
    if [ ! -d "$src" ] || ! ls "$src" | grep -q '\.json$'; then
      if [ -d "$PACKAGES/$pkg/.generated-graphql" ]; then
        say "skip $pkg: a GraphQL package (.generated-graphql), not a Smithy model"
      else
        say "FAIL $pkg: no models in $src (run with --convert, or the package's specs are not fetched)"
        status=1
      fi
      continue
    fi
    dst="$ROOT/models/$pkg"
    mkdir -p "$dst"
    new=0
    changed=0
    same=0
    removed=0
    for f in "$dst"/*.json; do
      [ -f "$f" ] || continue
      if [ ! -f "$src/$(basename "$f")" ]; then
        rm -f "$f"
        removed=$((removed + 1))
      fi
    done
    for f in "$src"/*.json; do
      b=$(basename "$f")
      if [ ! -f "$dst/$b" ]; then
        new=$((new + 1))
      elif cmp -s "$f" "$dst/$b"; then
        same=$((same + 1))
        continue
      else
        changed=$((changed + 1))
      fi
      cp "$f" "$dst/$b.tmp" && mv "$dst/$b.tmp" "$dst/$b"
    done
    # gRPC packages (task 23): the descriptors Distilled's convert writes next to the
    # services (src/descriptors.ts); the generator reads them from models/<pkg>/
    if [ -f "$PACKAGES/$pkg/src/descriptors.ts" ]; then
      cmp -s "$PACKAGES/$pkg/src/descriptors.ts" "$dst/descriptors.ts" ||
        cp "$PACKAGES/$pkg/src/descriptors.ts" "$dst/descriptors.ts"
    else
      rm -f "$dst/descriptors.ts"
    fi
    n=$((new + changed + same))
    total=$((total + n))
    say "ok   $pkg: $n models ($new new, $changed changed, $removed removed)"
  done
  say "models sync: $total models"
  exit $status
}

# ----------------------------------------------------------------------------------
# gen-diff (task 06): regenerate, diff against clients/<provider>/, check in every runtime
# ----------------------------------------------------------------------------------

# gen_package RUNTIME PKG OUT [--quiet]: bin/distilled-lua package for models/<pkg>/ with
# providers/<lua>.lua into OUT
gen_package() {
  rt=$1
  gp_pkg=$2
  gp_out=$3
  shift 3
  "$rt" "$ROOT/bin/distilled-lua" package --models "$ROOT/models/$gp_pkg" \
    --provider "$ROOT/providers/$(lua_name "$gp_pkg").lua" --out "$gp_out" "$@"
}

cmd_gen_diff() {
  [ -n "${1:-}" ] || die "usage: dl gen-diff <package>"
  pkg=$(pkg_of "$1")
  lua=$(lua_name "$pkg")
  spec="$ROOT/providers/$lua.lua"
  committed="$ROOT/clients/$lua"
  ls "$ROOT/models/$pkg"/*.json >/dev/null 2>&1 || die "no models in models/$pkg (dl models sync $pkg)"
  [ -f "$spec" ] || die "no provider spec: $spec"
  out="$TMP/gen-diff"
  rm -rf "$out"
  mkdir -p "$out/lua" "$out/luajit"
  status=0
  for rt in lua luajit; do
    if ! gen_package "$rt" "$pkg" "$out/$rt/$lua" --quiet >"$out/$rt.log" 2>&1; then
      say "FAIL generate ($rt):"
      grep -v '^ok ' "$out/$rt.log" | head -n 20
      exit 1
    fi
  done
  say "ok   generate: $(tail -n 1 "$out/lua.log" | sed "s|$out/lua/||")"
  if diff -r "$out/lua/$lua" "$out/luajit/$lua" >/dev/null; then
    say "ok   generate: lua and luajit write identical files"
  else
    say "FAIL generate: lua and luajit output differ"
    status=1
  fi
  if [ -d "$committed" ]; then
    if diff -ru "$committed" "$out/lua/$lua" >"$out/diff.txt"; then
      say "ok   diff: clients/$lua matches a fresh generation"
    else
      say "FAIL diff: clients/$lua differs from a fresh generation ($(wc -l <"$out/diff.txt" | tr -d ' ') diff lines, $out/diff.txt):"
      head -n 40 "$out/diff.txt"
      status=1
    fi
    check_dir="$ROOT/clients"
  else
    say "FAIL diff: clients/$lua is not committed (fresh output in $out/lua/$lua)"
    status=1
    check_dir="$out/lua"
  fi
  if stylua --check --config-path "$ROOT/stylua.toml" "$out/lua/$lua" >/dev/null 2>&1; then
    say "ok   stylua --check: generated Lua is formatted"
  else
    say "FAIL stylua --check on the generated Lua:"
    stylua --check --config-path "$ROOT/stylua.toml" "$out/lua/$lua" 2>&1 | head -n 20
    status=1
  fi
  for rt in $RUNTIMES; do
    case $rt in
      lua | luajit) res=$("$rt" "$LIB/gen_check.lua" "$ROOT" "$check_dir" "$lua" 2>&1) ;;
      rex) res=$(rex do "$LIB/gen_check.lua" "root=$ROOT" "dir=$check_dir" "provider=$lua" 2>&1) ;;
    esac
    code=$?
    printf '%s\n' "$res" | grep -v '^"'
    [ "$code" -eq 0 ] || status=1
  done
  if [ "$status" -eq 0 ]; then say "gen-diff $pkg: ok"; else say "gen-diff $pkg: FAIL"; fi
  exit $status
}

# ----------------------------------------------------------------------------------
# gen-all (task 10): regenerate every package with a provider spec into clients/
# ----------------------------------------------------------------------------------

# spec_pkgs: package names (from models/) whose Lua name has providers/<lua>.lua
spec_pkgs() {
  for d in "$ROOT"/models/*/; do
    p=$(basename "$d")
    [ -f "$ROOT/providers/$(lua_name "$p").lua" ] && printf '%s\n' "$p"
  done
}

# gen_all_one PKG: one package, its report in $TMP/gen-all/<pkg>.txt (run by xargs)
gen_all_one() {
  pkg=$1
  lua=$(lua_name "$pkg")
  report="$TMP/gen-all/$pkg.txt"
  if ! ls "$ROOT/models/$pkg"/*.json >/dev/null 2>&1; then
    say "FAIL $pkg: no models in models/$pkg (dl models sync $pkg)" >"$report"
    return 1
  fi
  gen_package "${DL_GEN_RUNTIME:-luajit}" "$pkg" "$ROOT/clients/$lua" >"$report" 2>&1
}

cmd_gen_all() {
  jobs=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
  pkgs=""
  while [ $# -gt 0 ]; do
    case $1 in
      --jobs)
        [ $# -ge 2 ] || die "--jobs needs a number"
        jobs=$2
        shift 2
        ;;
      --jobs=*)
        jobs=${1#--jobs=}
        shift
        ;;
      -*) die "gen-all: unknown flag $1" ;;
      *)
        p=$(pkg_of "$1")
        [ -f "$ROOT/providers/$(lua_name "$p").lua" ] || die "gen-all: no provider spec providers/$(lua_name "$p").lua"
        pkgs="$pkgs $p"
        shift
        ;;
    esac
  done
  [ -n "$pkgs" ] || pkgs=$(spec_pkgs)
  [ -n "$pkgs" ] || die "gen-all: no package has both models/<pkg>/ and providers/<lua>.lua"
  rm -rf "$TMP/gen-all"
  mkdir -p "$TMP/gen-all"
  # one process per package, $jobs at a time; each writes its own report
  # shellcheck disable=SC2086
  printf '%s\n' $pkgs | xargs -n 1 -P "$jobs" "$0" _gen-all-one
  ok=0
  failed=0
  skipped=0
  for pkg in $pkgs; do
    report="$TMP/gen-all/$pkg.txt"
    cat "$report"
    ok=$((ok + $(grep -c '^ok ' "$report")))
    failed=$((failed + $(grep -c '^FAIL ' "$report")))
    skipped=$((skipped + $(grep -c '^skip ' "$report")))
    # a package that failed as a whole (spec error, nothing generated) has no model lines
    if ! grep -q -E '^(ok|FAIL|skip) ' "$report"; then failed=$((failed + 1)); fi
  done
  say "gen-all: $(printf '%s\n' $pkgs | wc -l | tr -d ' ') packages; models: $ok ok, $failed failed, $skipped skipped"
  [ "$failed" -eq 0 ]
}

