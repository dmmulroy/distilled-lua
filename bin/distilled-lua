#!/usr/bin/env lua
-- distilled-lua: generate Lua API clients from Distilled's patched Smithy models.
--
--   distilled-lua generate --model <file> --provider <file> --out <dir>
--                          [--model-name <name>] [--ops a,b,c] [--no-telemetry] [--quiet]
--   distilled-lua package --models <dir> --provider <file> --out <dir>
--                         [--only a,b] [--no-telemetry] [--quiet]
--   distilled-lua generate-graphql --model <file> --provider <file> --out <dir>
--                                  [--no-telemetry] [--quiet]
--   distilled-lua vendor --out <dir>
--
-- Runs under lua (5.1 to 5.5) and luajit. Not meant for Rex: it writes files and makes
-- directories (with `mkdir -p`; this CLI is the only place the generator runs a process).

local function script_dir()
  local source = (arg and arg[0]) or debug.getinfo(1, "S").source
  source = string.gsub(source, "^@", "")
  return string.match(source, "^(.*)/[^/]*$") or "."
end

local ROOT = script_dir() .. "/.."
package.path = ROOT .. "/lua/?.lua;" .. ROOT .. "/lua/?/init.lua;" .. package.path

local USAGE = [[
usage:
  distilled-lua generate --model <file> --provider <file> --out <dir>
                         [--model-name <name>] [--ops a,b,c] [--no-telemetry] [--quiet]
      one model; --model-name makes it module <spec name>.<name> of a multi-model package
  distilled-lua package --models <dir> --provider <file> --out <dir>
                        [--only a,b] [--no-telemetry] [--quiet]
      every <dir>/*.json: one model -> <out>/ (module <name>); several ->
      <out>/<model>/ (module <name>.<model>) and the index <out>/init.lua
  distilled-lua generate-graphql --model <file> --provider <file> --out <dir>
                                 [--no-telemetry] [--quiet]
      a Distilled GraphQL model (.generated-graphql/<pkg>.json) -> init.lua, schema.lua,
      types.lua, README.md (task 16; `package` does this by itself for
      <models>/graphql/<pkg>.json)
  distilled-lua vendor --out <dir>
]]

local function die(message, code)
  io.stderr:write("distilled-lua: " .. message .. "\n")
  os.exit(code or 1)
end

local function shell_quote(s)
  return "'" .. string.gsub(s, "'", "'\\''") .. "'"
end

local function mkdir_p(dir)
  local ok = os.execute("mkdir -p " .. shell_quote(dir))
  if ok ~= true and ok ~= 0 then
    die("cannot create directory " .. dir)
  end
end

local function parse(args, spec)
  local out = {}
  local i = 1
  while i <= #args do
    local a = args[i]
    local name, inline_value = string.match(a, "^%-%-([%w%-]+)=(.*)$")
    name = name or string.match(a, "^%-%-([%w%-]+)$")
    if not name then
      die("unexpected argument " .. a .. "\n" .. USAGE, 2)
    end
    local kind = spec[name]
    if kind == nil then
      die("unknown option --" .. name .. "\n" .. USAGE, 2)
    end
    if kind == "flag" then
      out[name] = true
      i = i + 1
    else
      local v = inline_value
      if v == nil then
        v = args[i + 1]
        i = i + 2
      else
        i = i + 1
      end
      if v == nil then
        die("--" .. name .. " needs a value", 2)
      end
      out[name] = v
    end
  end
  return out
end

local function cmd_generate(args)
  local o = parse(args, {
    model = "value",
    provider = "value",
    out = "value",
    ops = "value",
    ["model-name"] = "value",
    ["no-telemetry"] = "flag",
    quiet = "flag",
  })
  for _, k in ipairs({ "model", "provider", "out" }) do
    if not o[k] then
      die("generate needs --" .. k .. "\n" .. USAGE, 2)
    end
  end
  local ops
  if o.ops then
    ops = {}
    for name in string.gmatch(o.ops, "[^,%s]+") do
      ops[#ops + 1] = name
    end
  end
  local gen = require("distilled.gen")
  local m, err = gen.model.load(o.model)
  if not m then
    die("generation failed:\n" .. err)
  end
  local files, gerr, plan = gen.generate({
    model = m,
    provider = o.provider,
    ops = ops,
    model_name = o["model-name"],
    telemetry = not o["no-telemetry"],
  })
  if not files then
    die("generation failed:\n" .. gerr)
  end
  mkdir_p(o.out)
  local ok, werr = gen.write(files, o.out)
  if not ok then
    die(werr)
  end
  if not o.quiet then
    for _, w in ipairs(m.warnings) do
      io.stderr:write("warning: " .. w .. "\n")
    end
    local bytes = 0
    for _, name in ipairs(files.order) do
      bytes = bytes + #files[name]
    end
    print(
      string.format(
        "wrote %s: %d operations, %d shapes, %d errors, %d files (%d bytes)",
        o.out,
        #plan.ops,
        #plan.nodes,
        #plan.errors,
        #files.order,
        bytes
      )
    )
  end
end

-- generate-graphql (task 16): one GraphQL model into one directory
local function cmd_generate_graphql(args)
  local o = parse(args, {
    model = "value",
    provider = "value",
    out = "value",
    ["no-telemetry"] = "flag",
    quiet = "flag",
  })
  for _, k in ipairs({ "model", "provider", "out" }) do
    if not o[k] then
      die("generate-graphql needs --" .. k .. "\n" .. USAGE, 2)
    end
  end
  local gql = require("distilled.gen.graphql")
  local files, err, plan =
    gql.generate({ model = o.model, provider = o.provider, telemetry = not o["no-telemetry"] })
  if not files then
    die("generation failed:\n" .. err)
  end
  mkdir_p(o.out)
  local ok, werr = gql.write(files, o.out)
  if not ok then
    die(werr)
  end
  if not o.quiet then
    print(
      string.format(
        "wrote %s: %d roots, %d object types, %d errors (graphql)",
        o.out,
        #plan.roots,
        #plan.objects,
        #plan.error_tags
      )
    )
  end
end

-- package: every model of a package directory, in the layout gen.package_layout picks.
-- Writes into a staging directory next to --out and swaps it in, so models that are gone
-- or no longer generate leave nothing stale behind. Prints one line per model:
--   ok   <pkg>/<model>: N operations ...
--   skip <pkg>/<model>: no operations | models.skip
--   FAIL <pkg>/<model>: <first line of the generation error>
-- Exit 0 when nothing failed, 1 when a model failed (the others are still written).

local function list_models(dir)
  local stems = {}
  local p = io.popen("ls -1 " .. shell_quote(dir) .. " 2>/dev/null")
  if not p then
    die("cannot list " .. dir)
  end
  for line in p:lines() do
    local stem = string.match(line, "^(.+)%.json$")
    if stem then
      stems[#stems + 1] = stem
    end
  end
  p:close()
  table.sort(stems)
  return stems
end

local function first_line(s)
  return string.match(tostring(s), "^([^\n]*)") or tostring(s)
end

-- A directory --out may replace: absent, empty, or a package this CLI generated.
local function replaceable(dir)
  local f = io.open(dir .. "/init.lua", "rb")
  if f then
    local head = f:read(600) or ""
    f:close()
    return string.find(head, "Generated by distilled-lua", 1, true) ~= nil
  end
  local p = io.popen("ls -A " .. shell_quote(dir) .. " 2>/dev/null")
  local any = p and p:read("*l")
  if p then
    p:close()
  end
  return any == nil
end

local function cmd_package(args)
  local o = parse(args, {
    models = "value",
    provider = "value",
    out = "value",
    only = "value",
    ["no-telemetry"] = "flag",
    quiet = "flag",
  })
  for _, k in ipairs({ "models", "provider", "out" }) do
    if not o[k] then
      die("package needs --" .. k .. "\n" .. USAGE, 2)
    end
  end
  local gen = require("distilled.gen")
  local spec, serr = gen.provider.load(o.provider)
  if not spec then
    die("generation failed:\n" .. serr)
  end
  local models_dir = string.gsub(o.models, "/+$", "")
  local pkg = string.match(models_dir, "([^/]+)$")
  local stems = list_models(models_dir)
  if #stems == 0 then
    die("no models in " .. models_dir .. " (verify/dl models sync " .. tostring(pkg) .. ")")
  end
  local layout, lerr = gen.package_layout(pkg, stems)
  if not layout then
    die("generation failed:\n" .. lerr)
  end
  if layout.lua ~= spec.name then
    die(
      "generation failed:\nprovider spec name "
        .. spec.name
        .. " is not the package's Lua name "
        .. layout.lua
    )
  end
  local names = {}
  for _, entry in ipairs(layout.models) do
    names[#names + 1] = entry.name
  end
  if layout.multi then
    local ok, cerr = gen.provider.check_models(spec, names)
    if not ok then
      die("generation failed:\n" .. cerr)
    end
  elseif next(spec.models.skip) or next(spec.models.override) then
    die("generation failed:\nprovider spec models: the package has a single model")
  end
  local only
  if o.only then
    only = {}
    for name in string.gmatch(o.only, "[^,%s]+") do
      only[name] = true
    end
    for name in pairs(only) do
      local known = false
      for _, n in ipairs(names) do
        known = known or n == name
      end
      if not known then
        die("--only names an unknown model " .. name, 2)
      end
    end
  end

  local out = string.gsub(o.out, "/+$", "")
  if not replaceable(out) then
    die(out .. " exists and is not a generated package; refusing to replace it")
  end
  local stage = out .. ".staging"
  os.execute("rm -rf " .. shell_quote(stage))
  mkdir_p(stage)

  local counts = { ok = 0, failed = 0, skipped = 0, ops = 0 }
  local services = {}
  local function report(status, entry, text)
    if not o.quiet or status == "FAIL" then
      print(string.format("%-4s %s/%s: %s", status, pkg, entry.stem, text))
    end
  end
  for _, entry in ipairs(layout.models) do
    if only and not only[entry.name] then
      -- not selected by --only (a partial run, for debugging): nothing written
    elseif spec.models.skip[entry.name] then
      counts.skipped = counts.skipped + 1
      report("skip", entry, "models.skip in the provider spec")
    else
      local m, merr = gen.model.load(models_dir .. "/" .. entry.stem .. ".json")
      if not m and string.find(tostring(merr), ": the model has no operations$") then
        -- Distilled skips them too (github/webhooks, resend/webhook_events)
        counts.skipped = counts.skipped + 1
        report("skip", entry, "no operations")
      elseif not m then
        counts.failed = counts.failed + 1
        report("FAIL", entry, first_line(merr))
      else
        -- a generator bug (a raise) fails this model only, not the whole package
        local compat = require("distilled.compat")
        local raised, files, gerr, plan = compat.pcall(gen.generate, {
          model = m,
          provider = spec,
          model_name = layout.multi and entry.name or nil,
          telemetry = not o["no-telemetry"],
        })
        if not raised then
          files, gerr = nil, "generator raised: " .. tostring(files)
        end
        if not files then
          counts.failed = counts.failed + 1
          report("FAIL", entry, first_line(gerr))
        else
          local dir = layout.multi and (stage .. "/" .. entry.dir) or stage
          mkdir_p(dir)
          local ok, werr = gen.write(files, dir)
          if not ok then
            die(werr)
          end
          counts.ok = counts.ok + 1
          counts.ops = counts.ops + #plan.ops
          services[#services + 1] = {
            name = entry.name,
            title = plan.provider.title,
            operations = #plan.ops,
            source = entry.stem .. ".json",
            hash = m.hash,
          }
          report("ok", entry, string.format("%d operations, %d shapes", #plan.ops, #plan.nodes))
        end
      end
      collectgarbage()
    end
  end
  if counts.ok == 0 then
    os.execute("rm -rf " .. shell_quote(stage))
    print(
      string.format(
        "package %s: nothing generated (%d failed, %d skipped)",
        pkg,
        counts.failed,
        counts.skipped
      )
    )
    os.exit(1)
  end
  if layout.multi then
    local files, ierr = gen.index({ provider = spec, services = services })
    if not files then
      die("generation failed:\n" .. ierr)
    end
    local ok, werr = gen.write(files, stage)
    if not ok then
      die(werr)
    end
  end
  os.execute("rm -rf " .. shell_quote(out))
  local parent = string.match(out, "^(.*)/[^/]*$")
  if parent and parent ~= "" then
    mkdir_p(parent)
  end
  local moved = os.execute("mv " .. shell_quote(stage) .. " " .. shell_quote(out))
  if moved ~= true and moved ~= 0 then
    die("cannot move " .. stage .. " to " .. out)
  end
  print(
    string.format(
      "package %s: %d ok, %d failed, %d skipped; %d operations -> %s",
      pkg,
      counts.ok,
      counts.failed,
      counts.skipped,
      counts.ops,
      out
    )
  )
  if counts.failed > 0 then
    os.exit(1)
  end
end

-- The runtime modules a generated client needs: lua/distilled/ without gen/ and testing/.
local function runtime_files()
  local list = {}
  local p = io.popen(
    "cd " .. shell_quote(ROOT .. "/lua") .. " && find distilled -name '*.lua' | LC_ALL=C sort"
  )
  if not p then
    die("cannot list " .. ROOT .. "/lua")
  end
  for line in p:lines() do
    if
      not string.find(line, "^distilled/gen/") and not string.find(line, "^distilled/testing/")
    then
      list[#list + 1] = line
    end
  end
  p:close()
  return list
end

local function cmd_vendor(args)
  local o = parse(args, { out = "value", quiet = "flag" })
  if not o.out then
    die("vendor needs --out\n" .. USAGE, 2)
  end
  local files = runtime_files()
  local written = 0
  for _, rel in ipairs(files) do
    local dir = string.match(rel, "^(.*)/[^/]*$")
    mkdir_p(o.out .. "/" .. dir)
    local src = assert(io.open(ROOT .. "/lua/" .. rel, "rb"))
    local text = src:read("*a")
    src:close()
    local dst, err = io.open(o.out .. "/" .. rel, "wb")
    if not dst then
      die("cannot write " .. o.out .. "/" .. rel .. ": " .. tostring(err))
    end
    dst:write(text)
    dst:close()
    written = written + 1
  end
  if not o.quiet then
    print(string.format("vendored %d runtime modules into %s/distilled", written, o.out))
  end
end

local argv = {}
for i = 1, #arg do
  argv[i] = arg[i]
end
local command = table.remove(argv, 1)
if command == "generate" then
  cmd_generate(argv)
elseif command == "generate-graphql" then
  cmd_generate_graphql(argv)
elseif command == "package" then
  cmd_package(argv)
elseif command == "vendor" then
  cmd_vendor(argv)
elseif command == nil or command == "help" or command == "--help" or command == "-h" then
  io.write(USAGE)
else
  die("unknown command " .. command .. "\n" .. USAGE, 2)
end
